name: NovaCloud DNS Anti-Leak Test
desc: Stash - foreign DNS by default, CN domains use Alibaba DoH

dns:
  nameserver: #!replace
    - 1.1.1.1
    - 8.8.8.8

  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  # Use separate DNS servers for specific domain names
  nameserver-policy:
    'www.baidu.com': 114.114.114.114
    '+.internal.crop.com': system
    '*.example.com':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    'geosite:cn':
      - 223.5.5.5
      - 119.29.29.29
