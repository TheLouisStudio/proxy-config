name: NovaCloud DNS Anti-Leak Test
desc: Stash - foreign DNS by default, CN domains use Alibaba DoH

dns:
  nameserver: #!replace
    - 1.1.1.1
    - 8.8.8.8

  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  nameserver-policy:
    'geosite:cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
