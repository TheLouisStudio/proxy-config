name: NovaCloud DNS Anti-Leak V4
desc: Stash DNS Anti-Leak - domestic Ali/Tencent DoH, foreign Cloudflare/Google DoH

dns:
  # =========================================================
  # 默认 DNS
  # 国外/未分类域名 → 国外加密 DNS
  # =========================================================
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # =========================================================
  # 节点服务器 DNS
  # 使用国内公共加密 DNS，保证节点解析和测速稳定
  # =========================================================
  proxy-server-nameserver: #!replace
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query

  # =========================================================
  # Bootstrap DNS
  # 仅用于解析 DNS 服务地址
  # =========================================================
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  # =========================================================
  # 国内域名
  # → 国内公共加密 DNS
  # =========================================================
  nameserver-policy:
    "geosite:cn": https://223.5.5.5/dns-query
    "geosite:private": https://223.5.5.5/dns-query
