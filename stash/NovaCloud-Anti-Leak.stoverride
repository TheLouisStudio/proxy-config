name: NovaCloud Anti-Leak
desc: DNS + WebRTC Anti-Leak

dns:
  enable: true
  ipv6: false

  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  default-nameserver:
    - 223.5.5.5
    - 1.2.4.8

  nameserver:
    - 'https://1.1.1.1/dns-query'
    - 'https://8.8.8.8/dns-query'

  proxy-server-nameserver:
    - 223.5.5.5
    - 'https://doh.pub/dns-query'

  nameserver-policy:
    'geosite:cn':
      - 223.5.5.5
      - 119.29.29.29

    'geosite:private':
      - 223.5.5.5

rules:
  - PROTOCOL,STUN,REJECT
