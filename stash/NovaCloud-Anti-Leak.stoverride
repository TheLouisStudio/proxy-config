name: NovaCloud DNS Anti-Leak V3
desc: Stash DNS - domestic domains use Ali/Tencent DoH, foreign domains use Cloudflare/Google DoH

dns:
  # 普通 DNS：国外 DNS
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # 节点域名解析：保持国外 DNS
  proxy-server-nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # Bootstrap：只负责解析 DNS 服务地址
  default-nameserver: #!replace
    - 1.1.1.1
    - 8.8.8.8

  # 国内域名使用国内 DoH
  nameserver-policy:
    "geosite:cn":
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query

    "geosite:private":
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
