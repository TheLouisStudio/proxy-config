name: NovaCloud DNS Anti-Leak V2
desc: Stash DNS test - replace normal DNS with encrypted foreign DNS

dns:
  # 完全替换订阅原有的普通 DNS
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # 完全替换代理节点域名解析 DNS
  proxy-server-nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://9.9.9.9/dns-query

  # 完全替换 Bootstrap DNS
  default-nameserver: #!replace
    - 1.1.1.1
    - 9.9.9.9
